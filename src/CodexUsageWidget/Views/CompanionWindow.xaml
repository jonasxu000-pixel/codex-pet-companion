<Window x:Class="CodexUsageWidget.Views.CompanionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex Pet Companion" Width="166" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#EDF4F7">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#263544"/><Setter Property="Foreground" Value="#EDF4F7"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="16" Background="#17232E" BorderBrush="#425768" BorderThickness="1" Padding="13,10">
  <StackPanel>
   <Grid x:Name="Badge" Cursor="Hand" MouseLeftButtonUp="BadgeClick">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#74DAC3" Margin="0,0,8,0"/>
     <TextBlock x:Name="BadgeLabel" Text="5h 剩余" FontSize="11" Foreground="#A9BFCD" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="BadgeValue" Grid.Column="1" Text="—" FontSize="20" FontWeight="SemiBold"/>
   </Grid>
   <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,15,0,0">
    <Grid><TextBlock Text="CODEX · 用量与活动" Foreground="#A9BFCD" FontSize="10"/><TextBlock x:Name="PinHint" Text="悬停展开" HorizontalAlignment="Right" FontSize="10" Foreground="#74DAC3"/></Grid>
    <ProgressBar x:Name="QuotaBar" Height="5" Minimum="0" Maximum="100" Margin="0,12,0,9" Foreground="#74DAC3" Background="#314554" BorderThickness="0"/>
    <TextBlock x:Name="ResetText" FontSize="12" Text="正在读取额度…"/>
    <TextBlock x:Name="WeekText" Margin="0,7,0,0" FontSize="11" Foreground="#A9BFCD"/>
    <Border Height="1" Background="#314554" Margin="0,14,0,12"/>
    <ComboBox x:Name="Tasks" FontSize="11" MaxDropDownHeight="220" SelectionChanged="TaskChanged" DisplayMemberPath="Title"/>
    <TextBlock x:Name="TaskTitle" FontSize="11" Foreground="#A9BFCD" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="ActivityText" Text="正在读取任务活动…" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="ActivityAge" Margin="0,6,0,0" FontSize="11" Foreground="#A9BFCD" TextWrapping="Wrap"/>
    <TextBlock x:Name="ProgressText" Margin="0,9,0,0" FontSize="11" Foreground="#CBDAE4" TextWrapping="Wrap" MaxHeight="88" TextTrimming="CharacterEllipsis"/>
    <Border Height="1" Background="#314554" Margin="0,12,0,10"/>
    <TextBlock x:Name="SourceText" FontSize="10" Foreground="#A9BFCD" TextWrapping="Wrap"/>
    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#F4C88C" TextWrapping="Wrap" Margin="0,5,0,0"/>
    <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="RefreshButton" Content="刷新额度" Click="RefreshClick"/>
     <Button x:Name="PinButton" Grid.Column="2" Content="固定展开" Click="PinClick"/>
    </Grid>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
