<Window x:Class="CodexUsageWidget.Views.CompanionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex Pet Companion" Width="174" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#292925">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F2F1ED"/><Setter Property="Foreground" Value="#373732"/>
   <Setter Property="BorderBrush" Value="#E4E2DC"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E9E7E0"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#897B68"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F0EEE8"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#F7F6F2"/><Setter Property="Foreground" Value="#45443E"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="SelectSurface" CornerRadius="8" Background="#F7F6F2" BorderBrush="#E4E2DC" BorderThickness="1" Padding="11,9">
        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#77746B" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectSurface" Property="Background" Value="#EEECE5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="11,9,28,9" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
      <Border Background="#FFFEFB" BorderBrush="#E4E2DC" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="300" Margin="0,4,0,0">
       <ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Button x:Name="Badge" Click="BadgeClick" Background="#FFFEFB" Padding="12,9" AutomationProperties.Name="展开或固定用量详情">
   <Grid Width="148"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#69816A" Margin="0,0,8,0"/>
     <TextBlock x:Name="BadgeLabel" Text="5h 剩余" FontSize="11" Foreground="#6C6A63" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="BadgeValue" Grid.Column="1" Text="—" FontSize="18" FontWeight="SemiBold"/>
   </Grid>
  </Button>
  <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=Badge}" Placement="Top" HorizontalOffset="-142" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="True" Focusable="False">
   <Border x:Name="Details" Width="316" CornerRadius="13" Background="#FFFEFB" BorderBrush="#DDDAD2" BorderThickness="1" Padding="18" TextElement.Foreground="#292925" TextElement.FontFamily="Microsoft YaHei UI, Segoe UI">
    <StackPanel>
     <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="✳" Foreground="#B4866F" FontSize="19" Margin="0,-3,8,0"/><TextBlock Text="Codex 小助手" FontWeight="SemiBold" FontSize="13"/></StackPanel><TextBlock x:Name="PinHint" Text="悬停展开" HorizontalAlignment="Right" FontSize="10" Foreground="#77746B"/></Grid>
     <Grid Margin="0,20,0,0"><TextBlock Text="五小时剩余额度" FontSize="12" Foreground="#6C6A63" VerticalAlignment="Center"/><TextBlock x:Name="DetailValue" Text="—" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="QuotaBar" Height="4" Minimum="0" Maximum="100" Margin="0,10,0,10" Foreground="#87947E" Background="#EEECE5" BorderThickness="0"/>
     <TextBlock x:Name="ResetText" FontSize="11" Foreground="#6C6A63" Text="正在读取额度…"/>
     <TextBlock x:Name="WeekText" Margin="0,7,0,0" FontSize="11" Foreground="#6C6A63"/>
     <Border Height="1" Background="#EAE7E0" Margin="0,18,0,16"/>
     <TextBlock Text="当前任务" FontSize="11" Foreground="#77746B" Margin="0,0,0,9"/>
     <ComboBox x:Name="Tasks" FontSize="11" SelectionChanged="TaskChanged" AutomationProperties.Name="选择显示的任务">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="242"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock x:Name="TaskTitle" FontSize="11" Foreground="#77746B" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="ActivityText" Text="正在读取任务活动…" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="ActivityAge" Margin="0,6,0,0" FontSize="11" Foreground="#77746B" TextWrapping="Wrap"/>
     <TextBlock x:Name="ProgressText" Margin="0,10,0,0" FontSize="11" Foreground="#56534C" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"/>
     <Border Height="1" Background="#EAE7E0" Margin="0,16,0,12"/>
     <TextBlock x:Name="SourceText" FontSize="10" Foreground="#77746B" TextWrapping="Wrap"/>
     <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#9C633F" TextWrapping="Wrap" Margin="0,5,0,0"/>
     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="RefreshButton" Content="刷新额度" Click="RefreshClick"/>
      <Button x:Name="PinButton" Grid.Column="2" Content="固定展开" Click="PinClick"/>
     </Grid>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</Window>
